{
  "name": "cesium-spatial",
  "version": "0.0.0",
  "private": true,
  "description": "Spatial indexing helpers (H3, S2) for CesiumJS",
  "license": "Apache-2.0",
  "author": "StevenPG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StevenPG/cesium-spatial.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:demo": "pnpm build && pnpm --filter @cesium-spatial/demo build",
    "dev": "pnpm --filter @cesium-spatial/demo dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "build:site": "pnpm build:docs && pnpm --filter @cesium-spatial/demo build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check:packages": "pnpm -r --filter \"./packages/*\" exec publint --strict",
    "check:pack": "node scripts/check-pack.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "typecheck:packages": "pnpm --filter \"./packages/*\" exec tsc --noEmit",
    "build:docs": "pnpm build && typedoc",
    "check:release": "node scripts/check-release.mjs",
    "release:tag": "node scripts/tag-release.mjs",
    "check:published": "node scripts/check-published.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "typedoc": "^0.28.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
