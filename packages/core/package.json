{
  "name": "@stevenpg/cesium-spatial-core",
  "version": "0.0.1",
  "description": "Shared rendering, camera and level-of-detail primitives for spatial index libraries on CesiumJS",
  "license": "Apache-2.0",
  "author": "StevenPG",
  "homepage": "https://stevenpg.github.io/cesium-spatial/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StevenPG/cesium-spatial.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/StevenPG/cesium-spatial/issues",
  "keywords": [
    "cesium",
    "cesiumjs",
    "spatial",
    "geospatial",
    "grid",
    "level-of-detail"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@cesium/engine": ">=1.0.0",
    "cesium": ">=1.95.0"
  },
  "peerDependenciesMeta": {
    "cesium": {
      "optional": true
    },
    "@cesium/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "cesium": "^1.120.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  }
}
