{
  "name": "@stevenpg/cesium-s2",
  "version": "0.0.1",
  "description": "S2 geometry cell helpers for CesiumJS: view-driven cell cover, batched rendering, entities and neighborhood traversal",
  "license": "Apache-2.0",
  "author": "StevenPG",
  "homepage": "https://stevenpg.github.io/cesium-spatial/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StevenPG/cesium-spatial.git",
    "directory": "packages/s2"
  },
  "bugs": "https://github.com/StevenPG/cesium-spatial/issues",
  "keywords": [
    "cesium",
    "cesiumjs",
    "s2",
    "s2-geometry",
    "spatial-index",
    "geospatial",
    "grid"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@stevenpg/cesium-spatial-core": "workspace:^",
    "s2js": "^1.44.0"
  },
  "peerDependencies": {
    "@cesium/engine": ">=1.0.0",
    "cesium": ">=1.95.0"
  },
  "peerDependenciesMeta": {
    "cesium": {
      "optional": true
    },
    "@cesium/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "cesium": "^1.120.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^5.0.3"
  }
}
